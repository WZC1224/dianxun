# mock (default) | live
DATA_MODE=mock

# Binance public market data (no key). Default works in CN better than api.binance.com
# BINANCE_API_BASE=https://data-api.binance.vision

# Flash news RSS when DATA_MODE=live (no key)
# NEWS_RSS_URL=https://cointelegraph.com/rss
# NEWS_SOURCE_LABEL=Cointelegraph

# Long/short + funding (Gate.io public, no key)
# GATE_API_BASE=https://api.gateio.ws

# Macro calendar (Forex Factory unofficial JSON this week)
# CALENDAR_FF_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
